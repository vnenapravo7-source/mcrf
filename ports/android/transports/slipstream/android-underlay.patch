@@ -0,0 +1,22 @@
+package main
+
+import "testing"
+
+func TestBackendUnderlay(t *testing.T) {
+	missing := func(string) (string, bool) { return "", false }
+	if got, err := backendUnderlay(missing, false); got != "" || err != nil {
+		t.Fatal("ordinary startup must retain the default underlay")
+	}
+	for _, input := range []string{"", "0", "+5", "05", "5 ", "9223372036854775808"} {
+		if got, err := backendUnderlay(func(string) (string, bool) { return input, true }, true); got != "" || err == nil {
+			t.Fatal("invalid physical network forwarded")
+		}
+	}
+	owned := func(string) (string, bool) { return "437197393933", true }
+	if got, err := backendUnderlay(owned, true); got != underlayKey+"=437197393933" || err != nil {
+		t.Fatal("exact physical network was not forwarded")
+	}
+	if got, err := backendUnderlay(owned, false); got != "" || err == nil {
+		t.Fatal("non-Android process accepted a physical network")
+	}
+}
