+
+// StageError preserves the cause for callers and exposes a fixed stage for diagnostics.
+type StageError struct {
+    Stage string
+    Err error
+}
+
+func (e *StageError) Error() string { return e.Stage + ": " + e.Err.Error() }
+func (e *StageError) Unwrap() error { return e.Err }
+
+func FailureStage(err error) string {
+    var failure *StageError
+    if errors.As(err, &failure) {
+        if failure.Stage == "tls" {
+            return tlsFailureStage(failure.Err)
+        }
+        return failure.Stage
+    }
+    var handshake *HandshakeError
+    if errors.As(err, &handshake) {
+        return "http"
+    }
+    return "unknown"
+}
+
+// Use typed errors. In particular, Go reports some peer TLS alerts as an
+// opaque cause under a remote net.OpError.
+func tlsFailureStage(err error) string {
+    var name x509.HostnameError
+    if errors.As(err, &name) {
+        return "tls_name"
+    }
+    var verification *tls.CertificateVerificationError
+    if errors.As(err, &verification) {
+        return "tls_trust"
+    }
+    var timeout net.Error
+    if errors.As(err, &timeout) && timeout.Timeout() {
+        return "tls_timeout"
+    }
+    var operation *net.OpError
+    if (errors.As(err, &operation) && operation.Op == "remote error") ||
+        errors.Is(err, syscall.ECONNRESET) || errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+        return "tls_remote"
+    }
+    var record tls.RecordHeaderError
+    if errors.As(err, &record) {
+        return "tls_record"
+    }
+    return "tls_other"
 }
 
