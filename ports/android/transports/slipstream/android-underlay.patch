+use std::io;
+
+const NETWORK_ENV: &str = "MCRF_SLIPSTREAM_UNDERLAY";
+
+#[cfg(any(test, target_os = "android"))]
+fn parse_handle(value: &std::ffi::OsStr) -> io::Result<u64> {
+    let handle = value.to_str().and_then(|text| {
+        let handle = text.parse::<u64>().ok()?;
+        (handle > 0 && handle <= i64::MAX as u64 && text == handle.to_string()).then_some(handle)
+    });
+    handle.ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "invalid Slipstream physical network"))
+}
+
+#[cfg(target_os = "android")]
+pub(crate) fn bind_udp(socket: &impl std::os::fd::AsRawFd) -> io::Result<()> {
+    let Some(value) = std::env::var_os(NETWORK_ENV) else {
+        return Ok(());
+    };
+    let handle = parse_handle(&value)?;
+    #[link(name = "android")]
+    unsafe extern "C" {
+        fn android_setsocknetwork(network: u64, fd: std::ffi::c_int) -> std::ffi::c_int;
+    }
+    // The local UDP endpoint is bound but still unconnected, and no DNS datagrams have been sent.
+    if unsafe { android_setsocknetwork(handle, socket.as_raw_fd()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "android"))]
+pub(crate) fn bind_udp<T>(_: &T) -> io::Result<()> {
+    if std::env::var_os(NETWORK_ENV).is_some() {
+        return Err(io::Error::new(io::ErrorKind::Unsupported, "Slipstream physical network requires Android"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::ffi::OsStr;
+
+    #[test]
+    fn canonical_android_handle() {
+        assert_eq!(parse_handle(OsStr::new("437197393933")).unwrap(), 437197393933);
+        for invalid in ["", "0", "-1", "+5", "05", "5 ", "9223372036854775808"] {
+            assert!(parse_handle(OsStr::new(invalid)).is_err());
+        }
+    }
+}
