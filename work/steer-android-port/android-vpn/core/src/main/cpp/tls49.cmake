# Android officially supports Go c-shared, not c-archive. This helper and
# libsteer_vpn belong to ONE signed external Steer module/worker, not another
# engine or main-APK native payload. Exact ABI/SHA receipt remains mandatory.
function(mcrf_steer_tls49 TARGET)
    if(DEFINED MCRF_TLS49_MANIFEST)
        file(READ "${MCRF_TLS49_MANIFEST}" TLS49_INPUTS)
        string(JSON MCRF_TLS49_LIBRARY GET "${TLS49_INPUTS}" abis "${ANDROID_ABI}" path)
        string(JSON MCRF_TLS49_SHA256 GET "${TLS49_INPUTS}" abis "${ANDROID_ABI}" sha256)
    endif()
    if(NOT DEFINED MCRF_TLS49_LIBRARY OR NOT DEFINED MCRF_TLS49_SHA256)
        message(FATAL_ERROR "P049 whole-source common Android shared-library receipt required")
    endif()
    if(NOT EXISTS "${MCRF_TLS49_LIBRARY}")
        message(FATAL_ERROR "Missing frozen Steer TLS helper")
    endif()
    file(SHA256 "${MCRF_TLS49_LIBRARY}" ACTUAL_TLS49)
    if(NOT ACTUAL_TLS49 STREQUAL MCRF_TLS49_SHA256)
        message(FATAL_ERROR "Frozen Steer TLS helper SHA mismatch")
    endif()
    add_library(mcrf_utls49 SHARED IMPORTED)
    set_target_properties(mcrf_utls49 PROPERTIES IMPORTED_LOCATION "${MCRF_TLS49_LIBRARY}" IMPORTED_SONAME "libmcrf_utls49.so")
    target_sources(${TARGET} PRIVATE "${STEER}/src/proto/tls/tls49.c")
    target_compile_definitions(${TARGET} PRIVATE MCRF_UTLS49=1)
    target_link_libraries(${TARGET} PRIVATE mcrf_utls49)
endfunction()
