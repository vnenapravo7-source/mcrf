# EXCLUDE_FROM_ALL: private full macro-consistent crypto/PKI fixture library.
# Production objects never gain certificate-generation APIs or fixture keys.
get_target_property(fixture_sources49 steer_vpn SOURCES)
list(FILTER fixture_sources49 EXCLUDE REGEX "(^|/)(bridge|trdial|roots|tls49)\\.c$|/daemon/main\\.c$")
add_library(steer_fixture_crypto49 STATIC EXCLUDE_FROM_ALL ${fixture_sources49})
foreach(property49 INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
    get_target_property(value49 steer_vpn ${property49})
    if(value49)
        if(property49 STREQUAL "COMPILE_DEFINITIONS")
            list(FILTER value49 EXCLUDE REGEX "^MCRF_UTLS49")
        endif()
        set_property(TARGET steer_fixture_crypto49 PROPERTY ${property49} "${value49}")
    endif()
endforeach()
target_compile_definitions(steer_fixture_crypto49 PRIVATE WOLFSSL_CERT_GEN)
target_link_libraries(steer_fixture_crypto49 PRIVATE mcrf_brotli_dec49 mcrf_zstd_dec49 ngtcp2_android z log)
set_target_properties(steer_fixture_crypto49 PROPERTIES POSITION_INDEPENDENT_CODE ON)
file(READ "${STEER}/tests/vlessmatch.c" fixture_body49)
string(REPLACE "/tmp/" "/data/local/tmp/" fixture_body49 "${fixture_body49}")
string(REPLACE "../src/" "${STEER}/src/" fixture_body49 "${fixture_body49}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/vlessmatch49.inc" "${fixture_body49}")
add_executable(cert_wire49_test EXCLUDE_FROM_ALL "${STEER}/tests/cert-wire49.c" "${STEER}/tests/certgen.c")
foreach(property49 INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
    get_target_property(value49 steer_vpn ${property49})
    if(value49)
        if(property49 STREQUAL "COMPILE_DEFINITIONS")
            list(FILTER value49 EXCLUDE REGEX "^MCRF_UTLS49")
        endif()
        set_property(TARGET cert_wire49_test PROPERTY ${property49} "${value49}")
    endif()
endforeach()
target_include_directories(cert_wire49_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${STEER}/tests")
target_compile_definitions(cert_wire49_test PRIVATE WOLFSSL_CERT_GEN STEER_HAVE_X509WRITE)
target_compile_options(cert_wire49_test PRIVATE -UNDEBUG -ffunction-sections -fdata-sections)
target_link_options(cert_wire49_test PRIVATE -Wl,--gc-sections -Wl,-z,max-page-size=16384)
target_link_libraries(cert_wire49_test PRIVATE steer_fixture_crypto49 mcrf_brotli_dec49 mcrf_zstd_dec49 ngtcp2_android z log)

# NEW composition proof: the production Go TLS/verification/decompression layer
# talks to this independently framed real-CV private PKI server. The legacy C
# TLS composition above is diagnostic only and cannot certify this path.
add_executable(cert_wire49_go_test EXCLUDE_FROM_ALL "${STEER}/tests/cert-wire49-go.c" "${STEER}/tests/certgen.c")
target_include_directories(cert_wire49_go_test PRIVATE ${INCLUDES} "${CMAKE_CURRENT_BINARY_DIR}" "${STEER}/tests")
target_compile_definitions(cert_wire49_go_test PRIVATE HAVE_CONFIG_H WOLFSSL_USER_SETTINGS WOLFSSL_CERT_GEN STEER_HAVE_X509WRITE MCRF_CERT_COMPRESSION49=1)
target_compile_options(cert_wire49_go_test PRIVATE -UNDEBUG -ffunction-sections -fdata-sections)
target_link_options(cert_wire49_go_test PRIVATE -Wl,--gc-sections -Wl,-z,max-page-size=16384 -Wl,--exclude-libs,ALL)
target_link_options(cert_wire49_go_test PRIVATE "-Wl,-rpath,$ORIGIN")
target_link_libraries(cert_wire49_go_test PRIVATE mcrf_utls49 steer_fixture_crypto49 mcrf_brotli_dec49 mcrf_zstd_dec49 ngtcp2_android z log)
