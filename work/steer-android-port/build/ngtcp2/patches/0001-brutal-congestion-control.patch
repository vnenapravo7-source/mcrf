+ * included in all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
+ * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+ * MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+ * NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+ * LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+ * OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+ * WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+ */
+#ifndef NGTCP2_BRUTAL_H
+#define NGTCP2_BRUTAL_H
+
+#ifdef HAVE_CONFIG_H
+#  include <config.h>
+#endif /* defined(HAVE_CONFIG_H) */
+
+#include <ngtcp2/ngtcp2.h>
+
+#include "ngtcp2_cc.h"
+
+/* Number of one-second slots over which the ACK rate is sampled. */
+#define NGTCP2_BRUTAL_SLOTS 5
+
+/*
+ * ngtcp2_cc_brutal is the "Brutal" congestion controller of Hysteria 2
+ * (apernet/hysteria, core/internal/congestion/brutal): a fixed target
+ * rate that does not go down on loss.  The sending rate is
+ * bps / ack_rate, and the window is bps * RTT * 2 / ack_rate, where
+ * ack_rate is the share of packets acknowledged over the last
+ * NGTCP2_BRUTAL_SLOTS seconds (not lower than 0.8).
+ *
+ * All arithmetic is integer: routers without an FPU are targets too.
+ */
+typedef struct ngtcp2_cc_brutal {
+  ngtcp2_cc cc;
+  /* bps is the target rate in BYTES per second, as in Hysteria. */
+  uint64_t bps;
+  /* ack_rate_pm is the ACK rate in permille: 800..1000. */
+  uint64_t ack_rate_pm;
+  struct {
+    /* sec is the second (ts / NGTCP2_SECONDS) the slot belongs to;
+       UINT64_MAX if the slot is unused. */
+    uint64_t sec;
+    uint64_t ack;
+    uint64_t loss;
+  } slot[NGTCP2_BRUTAL_SLOTS];
+} ngtcp2_cc_brutal;
+
+void ngtcp2_cc_brutal_init(ngtcp2_cc_brutal *brutal, ngtcp2_log *log,
+                           ngtcp2_conn_stat *cstat, uint64_t bps);
+
+#endif /* !defined(NGTCP2_BRUTAL_H) */
