diff --git a/qwdtt/csqtt_bridge.go b/qwdtt/csqtt_bridge.go
--- a/qwdtt/csqtt_bridge.go
+++ b/qwdtt/csqtt_bridge.go
@@ -142,3 +142,3 @@
 	if err = command.Start(); err != nil {
-		return errors.New("cannot start bundled CSQTT transport")
+		return fmt.Errorf("cannot start bundled CSQTT transport: %s", mcrfPublicChildFailure(c, err.Error()))
 	}
@@ -154,3 +154,8 @@
 	done := make(chan struct{})
-	go func() { command.Wait(); writer.Close(); close(done) }()
+	go func() {
+		waitErr := command.Wait()
