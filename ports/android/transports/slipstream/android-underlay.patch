+const underlayKey = "MCRF_SLIPSTREAM_UNDERLAY"
+
+func backendUnderlay(lookup func(string) (string, bool), android bool) (string, error) {
+	value, set := lookup(underlayKey)
+	if !set {
+		return "", nil
+	}
+	handle, err := strconv.ParseUint(value, 10, 63)
+	if !android || err != nil || handle == 0 || strconv.FormatUint(handle, 10) != value {
+		return "", errors.New("INVALID_PHYSICAL_NETWORK")
+	}
+	return underlayKey + "=" + value, nil
+}
+
 func run(ctx context.Context, c config, backend, privateParent string) error {
