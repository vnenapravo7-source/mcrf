        for step in 1..=3 {self.script.operation(link,step).await?;}
        Ok(credentials())
    }
    async fn legacy_path(&self,_:&str,_:usize,_:&VkCredentials,_:LegacyAttempt<'_>)->Result<TurnCredentials>{
