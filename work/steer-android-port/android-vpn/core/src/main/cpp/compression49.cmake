# P0#49 decoder-only dependencies. No encoder, CLI, external library installation,
# or production APK payload in the main application. Hash-pinned source intake.
function(mcrf_steer_cert_compression49 target)
    include(FetchContent)
    set(brotli_url49 "https://github.com/google/brotli/archive/refs/tags/v1.2.0.tar.gz")
    set(zstd_url49 "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz")
    if(DEFINED MCRF_CODEC49_ARCHIVES)
        set(brotli_url49 "${MCRF_CODEC49_ARCHIVES}/brotli-v1.2.0.tar.gz")
        set(zstd_url49 "${MCRF_CODEC49_ARCHIVES}/zstd-1.5.7.tar.gz")
        if(NOT EXISTS "${brotli_url49}" OR NOT EXISTS "${zstd_url49}")
            message(FATAL_ERROR "Frozen P049 decoder source archives missing")
        endif()
    endif()
    FetchContent_Declare(mcrf_brotli49
        URL "${brotli_url49}"
        URL_HASH SHA256=816c96e8e8f193b40151dad7e8ff37b1221d019dbcb9c35cd3fadbfe6477dfec)
    FetchContent_GetProperties(mcrf_brotli49)
    if(NOT mcrf_brotli49_POPULATED)
        FetchContent_Populate(mcrf_brotli49)
    endif()
    FetchContent_Declare(mcrf_zstd49
        URL "${zstd_url49}"
        URL_HASH SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3)
    FetchContent_GetProperties(mcrf_zstd49)
    if(NOT mcrf_zstd49_POPULATED)
        FetchContent_Populate(mcrf_zstd49)
    endif()
    file(GLOB brotli_common49 CONFIGURE_DEPENDS "${mcrf_brotli49_SOURCE_DIR}/c/common/*.c")
    file(GLOB brotli_decode49 CONFIGURE_DEPENDS "${mcrf_brotli49_SOURCE_DIR}/c/dec/*.c")
    add_library(mcrf_brotli_dec49 STATIC ${brotli_common49} ${brotli_decode49})
    target_include_directories(mcrf_brotli_dec49 PUBLIC "${mcrf_brotli49_SOURCE_DIR}/c/include")
    target_compile_definitions(mcrf_brotli_dec49 PRIVATE BROTLI_STATIC_COMPILATION)
    set_target_properties(mcrf_brotli_dec49 PROPERTIES POSITION_INDEPENDENT_CODE ON)
    file(GLOB zstd_common49 CONFIGURE_DEPENDS "${mcrf_zstd49_SOURCE_DIR}/lib/common/*.c")
    file(GLOB zstd_decode49 CONFIGURE_DEPENDS "${mcrf_zstd49_SOURCE_DIR}/lib/decompress/*.c")
    add_library(mcrf_zstd_dec49 STATIC ${zstd_common49} ${zstd_decode49})
    target_include_directories(mcrf_zstd_dec49 PUBLIC "${mcrf_zstd49_SOURCE_DIR}/lib")
    target_compile_definitions(mcrf_zstd_dec49 PRIVATE ZSTD_DISABLE_ASM=1 ZSTD_LEGACY_SUPPORT=0 ZSTD_LIB_DEPRECATED=0)
    set_target_properties(mcrf_zstd_dec49 PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_sources(${target} PRIVATE "${STEER}/src/proto/tls/cert_compress49.c")
    target_compile_definitions(${target} PRIVATE MCRF_CERT_COMPRESSION49=1)
    target_link_libraries(${target} PRIVATE mcrf_brotli_dec49 mcrf_zstd_dec49 z)
endfunction()
