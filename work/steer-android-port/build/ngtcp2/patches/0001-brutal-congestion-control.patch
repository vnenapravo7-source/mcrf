+ * included in all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
+ * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+ * MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+ * NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+ * LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+ * OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+ * WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+ */
+#include "ngtcp2_brutal.h"
+
+#include <assert.h>
+
+#include "ngtcp2_macro.h"
+#include "ngtcp2_conn_stat.h"
+
+/*
+ * Brutal из Hysteria 2 (apernet/hysteria, core/internal/congestion/brutal/brutal.go и
+ * common/pacer.go), перенесённый на интерфейс ngtcp2_cc. Соответствие эталону:
+ *
+ *   эталон                                     здесь
+ *   -----------------------------------------  ----------------------------------------
+ *   pktInfoSlotCount = 5 (слоты по секундам)   NGTCP2_BRUTAL_SLOTS
+ *   minSampleCount = 50                        NGTCP2_BRUTAL_MIN_SAMPLES
+ *   minAckRate = 0.8                           NGTCP2_BRUTAL_MIN_ACK_RATE_PM (в промилле)
+ *   congestionWindowMultiplier = 2             NGTCP2_BRUTAL_CWND_MULT
+ *   OnCongestionEventEx: счёт пакетов          on_pkt_acked / on_pkt_lost + on_ack_recv
+ *   GetCongestionWindow                        brutal_apply: cwnd
+ *   Pacer (bps / ackRate)                      brutal_apply: pacing_interval_m
+ *
+ * Отличия, и почему они не меняют поведение:
+ *   - Дробные числа заменены целыми (ack_rate — в промилле): у роутеров без FPU (mips soft-float)
+ *     дробные вычисления идут программно, а точности промилле хватает — эталон округляет
+ *     окно до байта, а скорость от сотой доли процента не меняется.
+ *   - Окно берётся от сглаженного RTT, как в эталоне (SmoothedRTT). До первого замера RTT эталон
+ *     держит 10240 байт; здесь — начальное окно ngtcp2 (10 пакетов, RFC 9002), то же по сути.
+ *   - Пейсер эталона — ведро токенов; в ngtcp2 своё ведро (ngtcp2_conn_update_pkt_tx_time), которому
+ *     нужен только интервал на байт (pacing_interval_m), его и выставляем. Пачка отправки —
+ *     send_quantum: миллисекунда на выбранной скорости, как у эталона (MinPacingDelay).
+ *   - Число пакетов в слотах считается по подтверждённым и потерянным пакетам с ответом на
+ *     запрос (ack-eliciting), а не по всем: в журнале потерь ngtcp2 других нет.
+ *
+ * Brutal не снижает скорость при потерях (on_persistent_congestion, congestion_event,
+ * on_spurious_congestion не заданы вовсе) — единственная реакция на потери: поправка ack_rate,
+ * то есть посылать больше, чтобы после потерь дошла заданная скорость.
+ */
+#define NGTCP2_BRUTAL_MIN_SAMPLES 50
+#define NGTCP2_BRUTAL_MIN_ACK_RATE_PM 800
+#define NGTCP2_BRUTAL_CWND_MULT 2
+
+static void brutal_apply(ngtcp2_cc_brutal *b, ngtcp2_conn_stat *cstat) {
+  uint64_t rate, cwnd, t;
+  size_t quantum;
+
+  /* Скорость отправки, байт/с: bps / ack_rate. */
+  rate = b->bps * 1000 / b->ack_rate_pm;
+  if (rate == 0) {
+    rate = 1;
+  }
+
+  /* ns на байт с десятью битами дробной части — единица pacing_interval_m. */
+  cstat->pacing_interval_m = ngtcp2_max((NGTCP2_SECONDS << 10) / rate, 1);
+
+  quantum = (size_t)ngtcp2_min(rate / 1000, (uint64_t)64 * 1024);
+  cstat->send_quantum =
+    ngtcp2_max(quantum, 10 * cstat->max_tx_udp_payload_size);
+
+  if (cstat->first_rtt_sample_ts == UINT64_MAX) {
+    cwnd = ngtcp2_cc_compute_initcwnd(cstat->max_tx_udp_payload_size);
+  } else {
+    /* bps * RTT * 2 / ack_rate: RTT в микросекундах, ack_rate в промилле.
+       bps до 2^31 и RTT до 10 с дают не больше 2^31 * 10^7 * 2 < 2^56: не переполняется. */
+    t = b->bps * (cstat->smoothed_rtt / NGTCP2_MICROSECONDS);
+    cwnd = t * NGTCP2_BRUTAL_CWND_MULT / (b->ack_rate_pm * 1000);
+    cwnd = ngtcp2_max(cwnd, cstat->max_tx_udp_payload_size);
+  }
+  cstat->cwnd = cwnd;
+}
+
+static void brutal_count(ngtcp2_cc_brutal *b, ngtcp2_tstamp ts, int lost) {
+  uint64_t sec = ts / NGTCP2_SECONDS;
+  size_t i = (size_t)(sec % NGTCP2_BRUTAL_SLOTS);
+
+  if (b->slot[i].sec != sec) {
+    /* Слот ещё не занят или слишком стар — сбросить. */
+    b->slot[i].sec = sec;
+    b->slot[i].ack = 0;
+    b->slot[i].loss = 0;
+  }
+  if (lost) {
+    ++b->slot[i].loss;
+  } else {
+    ++b->slot[i].ack;
+  }
+}
+
+static void brutal_update_ack_rate(ngtcp2_cc_brutal *b, ngtcp2_tstamp ts) {
+  uint64_t sec = ts / NGTCP2_SECONDS;
+  uint64_t ack = 0, loss = 0, total;
+  size_t i;
+
+  for (i = 0; i < NGTCP2_BRUTAL_SLOTS; ++i) {
+    if (b->slot[i].sec == UINT64_MAX || b->slot[i].sec + NGTCP2_BRUTAL_SLOTS < sec) {
+      continue;
+    }
+    ack += b->slot[i].ack;
+    loss += b->slot[i].loss;
+  }
+
+  total = ack + loss;
+  if (total < NGTCP2_BRUTAL_MIN_SAMPLES) {
+    b->ack_rate_pm = 1000;
+    return;
+  }
+  b->ack_rate_pm = ngtcp2_max(ack * 1000 / total,
+                              (uint64_t)NGTCP2_BRUTAL_MIN_ACK_RATE_PM);
+}
+
+static void brutal_on_pkt_acked(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts) {
+  ngtcp2_cc_brutal *b = ngtcp2_struct_of(cc, ngtcp2_cc_brutal, cc);
+  (void)cstat;
+  (void)pkt;
+
+  brutal_count(b, ts, 0);
+}
+
+static void brutal_on_pkt_lost(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                               const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts) {
+  ngtcp2_cc_brutal *b = ngtcp2_struct_of(cc, ngtcp2_cc_brutal, cc);
+  (void)cstat;
+  (void)pkt;
+
+  brutal_count(b, ts, 1);
+}
+
+static void brutal_on_ack_recv(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                               const ngtcp2_cc_ack *ack, ngtcp2_tstamp ts) {
+  ngtcp2_cc_brutal *b = ngtcp2_struct_of(cc, ngtcp2_cc_brutal, cc);
+  (void)ack;
+
+  brutal_update_ack_rate(b, ts);
+  brutal_apply(b, cstat);
+}
+
+/* Потери, замеченные по таймеру, а не по ACK, тоже пересчитывают поправку: следующий ACK может
+   прийти нескоро. Скорость при этом не снижается — congestion_event у других алгоритмов
+   именно здесь режет окно. */
+static void brutal_congestion_event(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                    ngtcp2_tstamp sent_ts,
+                                    const ngtcp2_cc_ack *ack,
+                                    ngtcp2_tstamp ts) {
+  ngtcp2_cc_brutal *b = ngtcp2_struct_of(cc, ngtcp2_cc_brutal, cc);
+  (void)sent_ts;
+  (void)ack;
+
+  brutal_update_ack_rate(b, ts);
+  brutal_apply(b, cstat);
+}
+
+static void brutal_reset(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                         ngtcp2_tstamp ts) {
+  ngtcp2_cc_brutal *b = ngtcp2_struct_of(cc, ngtcp2_cc_brutal, cc);
+  size_t i;
+  (void)ts;
+
+  for (i = 0; i < NGTCP2_BRUTAL_SLOTS; ++i) {
+    b->slot[i].sec = UINT64_MAX;
+    b->slot[i].ack = 0;
+    b->slot[i].loss = 0;
+  }
+  b->ack_rate_pm = 1000;
+
+  brutal_apply(b, cstat);
+}
+
+void ngtcp2_cc_brutal_init(ngtcp2_cc_brutal *brutal, ngtcp2_log *log,
+                           ngtcp2_conn_stat *cstat, uint64_t bps) {
+  *brutal = (ngtcp2_cc_brutal){
+    .cc =
+      {
+        .log = log,
+        .on_pkt_acked = brutal_on_pkt_acked,
+        .on_pkt_lost = brutal_on_pkt_lost,
+        .congestion_event = brutal_congestion_event,
+        .on_ack_recv = brutal_on_ack_recv,
+        .reset = brutal_reset,
+      },
+    .bps = ngtcp2_max(bps, (uint64_t)1),
+  };
+
+  brutal_reset(&brutal->cc, cstat, 0);
+}
