@@ -0,0 +1,9 @@
+//go:build windows
+
+package main
+
+import ("fmt"; "net"; "os")
+
+// MCRF owns the Windows TUN through sing-box. qWDTT stays a SOCKS sidecar.
+func recvTunFD(string) (*os.File,error) { return nil,fmt.Errorf("Android rawtun is unsupported on Windows; use SOCKS mode") }
+func listenUDP(address string) (net.PacketConn,error) { return net.ListenPacket("udp",address) }
