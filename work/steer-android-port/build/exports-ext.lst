# Экспорт libsteer для модулей ВНЕ этого дерева: их исходников здесь нет, и build/libs-exports.sh не
# может вычислить их нужды сам. По строке на символ; # — пояснение. Потребители:
#   steer-box-connector (github.com/splify2/steer-box-connector) — sing-box для podkop и forkop:
#   HTTP/2 для DoH (Quad9 отвечает только по h2) и X25519 для sing-box generate reality-keypair;
#   TLS 1.3 и REALITY для своих соединений с узлами (src/bconn.c); наборы sing-box .srs для
#   `sing-box rule-set` (src/ruleset_cli.c). Сверено по его исходникам 02ca44e: 20 символов.
# Убрать символ отсюда — сломать сборку того модуля; добавить — только по его просьбе.
h2_end_stream
h2_next
h2_read
h2_start_ex
h2_strerror
h2_write
sc_x25519_base
reality_build_hello_carry
srs_clause
srs_clause_n
srs_open
srs_release
srs_skipped
srs_walk
tls13_free
tls13_handshake_auth
tls13_read
tls13_verify_reason
tls13_write
tls_cert_roots
